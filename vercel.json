{
  "github": {
    "silent": false
  },
  "regions": [
    "hnd1"
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://utinc.dev https://*.utinc.dev https://*.vercel.app"
        }
      ]
    }
  ]
}
